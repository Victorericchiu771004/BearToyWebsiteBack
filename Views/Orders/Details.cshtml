@model BearToyWebsiteBack.Models.ViewModels.OrderViewModel
@using BearToyWebsiteBack.Models.ViewModels

@{
    ViewData["Title"] = "訂單詳細資料";
}

<div class="fade-in">
    <!-- 頁面標題和導覽 -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">
                <i class="bi bi-receipt text-info me-2"></i>
                訂單詳細資料
            </h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a asp-action="Index">訂單管理</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.OrderNumber</li>
                </ol>
            </nav>
        </div>
        <div>
            <a asp-action="UpdateStatus" asp-route-id="@Model.Id" class="btn btn-warning me-2">
                <i class="bi bi-arrow-repeat me-2"></i>
                更新狀態
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-2"></i>
                返回列表
            </a>
        </div>
    </div>

    <!-- 成功訊息 -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- 主要內容 -->
        <div class="col-xl-8">
            <!-- 訂單基本資訊 -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-info-circle me-2"></i>
                        訂單基本資訊
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="border rounded p-3">
                                <h6 class="text-muted mb-2">訂單編號</h6>
                                <strong class="text-primary fs-5">@Model.OrderNumber</strong>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border rounded p-3">
                                <h6 class="text-muted mb-2">訂單日期</h6>
                                <strong>@Model.OrderDate.ToString("yyyy年MM月dd日 HH:mm")</strong>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border rounded p-3">
                                <h6 class="text-muted mb-2">訂單狀態</h6>
                                <span class="badge @OrderStatusHelper.GetStatusBadgeClass(Model.Status) fs-6">
                                    @Model.StatusDisplayName
                                </span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border rounded p-3">
                                <h6 class="text-muted mb-2">訂單總額</h6>
                                <strong class="text-success fs-5">NT$ @Model.TotalAmount.ToString("N0")</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 訂單商品 -->
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-box-seam me-2"></i>
                        訂單商品
                    </h5>
                    <span class="badge bg-secondary">共 @Model.OrderItems.Sum(i => i.Quantity) 件商品</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th style="width: 80px;">圖片</th>
                                    <th>商品資訊</th>
                                    <th style="width: 100px;">單價</th>
                                    <th style="width: 80px;">數量</th>
                                    <th style="width: 120px;">小計</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderItems)
                                {
                                    <tr>
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.ProductImageUrl))
                                            {
                                                <img src="@item.ProductImageUrl" alt="@item.ProductName" 
                                                     class="img-thumbnail" style="width: 60px; height: 60px; object-fit: cover;">
                                            }
                                            else
                                            {
                                                <div class="d-flex align-items-center justify-content-center bg-light" 
                                                     style="width: 60px; height: 60px; border-radius: 4px;">
                                                    <i class="bi bi-image text-muted"></i>
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <div>
                                                <strong>@item.ProductName</strong>
                                                <small class="d-block text-muted">SKU: @item.ProductSku</small>
                                                @if (!string.IsNullOrEmpty(item.VariantDescription))
                                                {
                                                    <small class="d-block text-info">規格: @item.VariantDescription</small>
                                                }
                                                @if (item.IsGift)
                                                {
                                                    <span class="badge bg-success mt-1">贈品</span>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <strong>NT$ @item.UnitPrice.ToString("N0")</strong>
                                        </td>
                                        <td>
                                            <span class="badge bg-info">@item.Quantity</span>
                                        </td>
                                        <td>
                                            <strong class="text-primary">NT$ @item.TotalPrice.ToString("N0")</strong>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="bg-light">
                                <tr>
                                    <td colspan="4" class="text-end"><strong>訂單總額：</strong></td>
                                    <td><strong class="text-success fs-5">NT$ @Model.TotalAmount.ToString("N0")</strong></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <!-- 備註 -->
            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="bi bi-sticky me-2"></i>
                            訂單備註
                        </h5>
                    </div>
                    <div class="card-body">
                        <p class="mb-0">@Model.Notes</p>
                    </div>
                </div>
            }
        </div>

        <!-- 側邊欄 -->
        <div class="col-xl-4">
            <!-- 客戶資訊 -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-person me-2"></i>
                        客戶資訊
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <h6 class="text-muted mb-1">客戶姓名</h6>
                        <strong>@Model.UserName</strong>
                    </div>
                    <div class="mb-3">
                        <h6 class="text-muted mb-1">電子郵件</h6>
                        <span>@Model.UserEmail</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.RecipientName) && Model.RecipientName != Model.UserName)
                    {
                        <div class="mb-3">
                            <h6 class="text-muted mb-1">收件人</h6>
                            <strong>@Model.RecipientName</strong>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.ContactPhone))
                    {
                        <div class="mb-3">
                            <h6 class="text-muted mb-1">聯絡電話</h6>
                            <span>@Model.ContactPhone</span>
                        </div>
                    }
                </div>
            </div>

            <!-- 狀態資訊 -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-clipboard-data me-2"></i>
                        狀態資訊
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <h6 class="text-muted mb-1">付款方式</h6>
                        <span>@Model.PaymentMethod</span>
                    </div>
                    <div class="mb-3">
                        <h6 class="text-muted mb-1">付款狀態</h6>
                        <span class="badge @OrderStatusHelper.GetPaymentStatusBadgeClass(Model.PaymentStatus)">
                            @OrderStatusHelper.GetStatusDisplayName(Model.PaymentStatus, OrderStatusHelper.PaymentStatuses)
                        </span>
                    </div>
                    <div class="mb-3">
                        <h6 class="text-muted mb-1">出貨方式</h6>
                        <span>@Model.ShippingMethod</span>
                    </div>
                    <div class="mb-3">
                        <h6 class="text-muted mb-1">出貨狀態</h6>
                        <span class="badge @OrderStatusHelper.GetShippingStatusBadgeClass(Model.ShippingStatus)">
                            @OrderStatusHelper.GetStatusDisplayName(Model.ShippingStatus, OrderStatusHelper.ShippingStatuses)
                        </span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.TrackingNumber))
                    {
                        <div class="mb-3">
                            <h6 class="text-muted mb-1">追蹤號碼</h6>
                            <span class="text-primary">@Model.TrackingNumber</span>
                        </div>
                    }
                </div>
            </div>

            <!-- 配送資訊 -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-geo-alt me-2"></i>
                        配送資訊
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <h6 class="text-muted mb-1">配送地址</h6>
                        <address class="mb-0">@Model.ShippingAddress</address>
                    </div>
                </div>
            </div>

            <!-- 時間軸 -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-clock-history me-2"></i>
                        處理進度
                    </h5>
                </div>
                <div class="card-body">
                    <div class="timeline">
                        <div class="timeline-item completed">
                            <div class="timeline-marker bg-success">
                                <i class="bi bi-check"></i>
                            </div>
                            <div class="timeline-content">
                                <h6>訂單建立</h6>
                                <small class="text-muted">@Model.OrderDate.ToString("yyyy/MM/dd HH:mm")</small>
                            </div>
                        </div>
                        
                        @if (Model.PaymentConfirmationDate.HasValue)
                        {
                            <div class="timeline-item completed">
                                <div class="timeline-marker bg-success">
                                    <i class="bi bi-credit-card"></i>
                                </div>
                                <div class="timeline-content">
                                    <h6>付款確認</h6>
                                    <small class="text-muted">@Model.PaymentConfirmationDate.Value.ToString("yyyy/MM/dd HH:mm")</small>
                                </div>
                            </div>
                        }
                        
                        @if (Model.ShippingDate.HasValue)
                        {
                            <div class="timeline-item completed">
                                <div class="timeline-marker bg-success">
                                    <i class="bi bi-truck"></i>
                                </div>
                                <div class="timeline-content">
                                    <h6>商品出貨</h6>
                                    <small class="text-muted">@Model.ShippingDate.Value.ToString("yyyy/MM/dd HH:mm")</small>
                                    @if (!string.IsNullOrEmpty(Model.TrackingNumber))
                                    {
                                        <small class="d-block text-primary">追蹤號碼: @Model.TrackingNumber</small>
                                    }
                                </div>
                            </div>
                        }
                        
                        @if (Model.CompletionDate.HasValue)
                        {
                            <div class="timeline-item completed">
                                <div class="timeline-marker bg-success">
                                    <i class="bi bi-check-circle"></i>
                                </div>
                                <div class="timeline-content">
                                    <h6>訂單完成</h6>
                                    <small class="text-muted">@Model.CompletionDate.Value.ToString("yyyy/MM/dd HH:mm")</small>
                                </div>
                            </div>
                        }
                        else if (Model.Status != "cancelled")
                        {
                            <div class="timeline-item pending">
                                <div class="timeline-marker bg-secondary">
                                    <i class="bi bi-hourglass-split"></i>
                                </div>
                                <div class="timeline-content">
                                    <h6>等待完成</h6>
                                    <small class="text-muted">處理中...</small>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- 操作按鈕 -->
            <div class="card">
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="UpdateStatus" asp-route-id="@Model.Id" class="btn btn-warning">
                            <i class="bi bi-arrow-repeat me-2"></i>
                            更新訂單狀態
                        </a>
                        <div class="row g-2">
                            <div class="col">
                                <button type="button" class="btn btn-outline-primary w-100" onclick="window.print()">
                                    <i class="bi bi-printer me-1"></i>
                                    列印
                                </button>
                            </div>
                            <div class="col">
                                <button type="button" class="btn btn-outline-info w-100" onclick="exportOrder()">
                                    <i class="bi bi-download me-1"></i>
                                    匯出
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .timeline {
        position: relative;
        padding-left: 0;
    }
    
    .timeline-item {
        position: relative;
        padding-left: 40px;
        margin-bottom: 20px;
    }
    
    .timeline-item::before {
        content: '';
        position: absolute;
        left: 15px;
        top: 30px;
        bottom: -20px;
        width: 2px;
        background-color: #dee2e6;
    }
    
    .timeline-item:last-child::before {
        display: none;
    }
    
    .timeline-marker {
        position: absolute;
        left: 0;
        top: 0;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 14px;
    }
    
    .timeline-content h6 {
        margin-bottom: 5px;
        font-weight: 600;
    }
    
    .timeline-item.completed .timeline-content h6 {
        color: #28a745;
    }
    
    .timeline-item.pending .timeline-content h6 {
        color: #6c757d;
    }

    @@media print {
        .btn, .breadcrumb, nav, .card-header {
            display: none !important;
        }
        
        .card {
            border: none !important;
            box-shadow: none !important;
        }
    }
</style>

@section Scripts {
    <script>
        function exportOrder() {
            // 這裡可以實作匯出功能，例如產生PDF或Excel
            alert('匯出功能開發中...');
        }
    </script>
}