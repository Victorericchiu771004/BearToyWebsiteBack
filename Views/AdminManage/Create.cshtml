@model BearToyWebsiteBack.Models.ViewModels.CreateAdminViewModel
@{
    ViewData["Title"] = "新增管理員";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>新增管理員</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>返回列表
    </a>
</div>

<form asp-action="Create" method="post">
    <div class="row">
        <div class="col-lg-8">
            <!-- 基本資訊 -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">基本資訊</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Username" class="form-label"></label>
                                <input asp-for="Username" class="form-control" autocomplete="username" />
                                <span asp-validation-for="Username" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="FullName" class="form-label"></label>
                                <input asp-for="FullName" class="form-control" />
                                <span asp-validation-for="FullName" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" type="email" autocomplete="email" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Phone" class="form-label"></label>
                                <input asp-for="Phone" class="form-control" type="tel" autocomplete="tel" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 密碼設定 -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">密碼設定</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Password" class="form-label"></label>
                                <input asp-for="Password" class="form-control" type="password" autocomplete="new-password" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                                <small class="form-text text-muted">密碼長度至少6個字元</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="ConfirmPassword" class="form-label"></label>
                                <input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- 帳號設定 -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">帳號設定</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label"></label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 角色指派 -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">角色指派</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">選擇角色</label>
                        @foreach (var role in ViewBag.Roles)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="SelectedRoleIds" value="@role.RoleId" id="role_@role.RoleId" />
                                <label class="form-check-label" for="role_@role.RoleId">
                                    <strong>@role.RoleName</strong>
                                    @if (!string.IsNullOrEmpty(role.Description))
                                    {
                                        <br><small class="text-muted">@role.Description</small>
                                    }
                                </label>
                            </div>
                        }
                        <span asp-validation-for="SelectedRoleIds" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- 操作按鈕 -->
            <div class="card">
                <div class="card-body">
                    <button type="submit" class="btn btn-primary w-100 mb-2">
                        <i class="bi bi-save me-1"></i>建立管理員
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary w-100">
                        <i class="bi bi-x-circle me-1"></i>取消
                    </a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}