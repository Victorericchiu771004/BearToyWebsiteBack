@model BearToyWebsiteBack.Models.ViewModels.PromotionViewModel
@{
    ViewData["Title"] = "活動詳情";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>活動詳情</h2>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="fas fa-edit"></i> 編輯活動
        </a>
        <a asp-action="Analytics" asp-route-id="@Model.Id" class="btn btn-success">
            <i class="fas fa-chart-bar"></i> 數據分析
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> 返回列表
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <!-- 基本資訊 -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">基本資訊</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-4">活動名稱</dt>
                            <dd class="col-sm-8">@Model.Name</dd>
                            
                            <dt class="col-sm-4">促銷類型</dt>
                            <dd class="col-sm-8">
                                <span class="badge bg-secondary">
                                    @Model.BadgeText
                                </span>
                            </dd>
                            
                            <dt class="col-sm-4">折扣內容</dt>
                            <dd class="col-sm-8">
                                @if (Model.DiscountType == "Percentage")
                                {
                                    <span>@Model.DiscountValue% 折扣</span>
                                }
                                else if (Model.DiscountType == "FixedAmount")
                                {
                                    <span>$@Model.DiscountValue 折扣</span>
                                }
                            </dd>
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-4">活動狀態</dt>
                            <dd class="col-sm-8">
                                @switch (Model.CurrentStatus)
                                {
                                    case "進行中":
                                        <span class="badge bg-success">@Model.CurrentStatus</span>
                                        break;
                                    case "已停用":
                                        <span class="badge bg-secondary">@Model.CurrentStatus</span>
                                        break;
                                    case "未開始":
                                        <span class="badge bg-warning">@Model.CurrentStatus</span>
                                        break;
                                    case "已過期":
                                        <span class="badge bg-danger">@Model.CurrentStatus</span>
                                        break;
                                    default:
                                        <span class="badge bg-light text-dark">@Model.CurrentStatus</span>
                                        break;
                                }
                            </dd>
                            
                            <dt class="col-sm-4">建立時間</dt>
                            <dd class="col-sm-8">@Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")</dd>
                            
                            <dt class="col-sm-4">更新時間</dt>
                            <dd class="col-sm-8">@Model.UpdatedAt.ToString("yyyy/MM/dd HH:mm")</dd>
                        </dl>
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-12">
                        <dt>活動描述</dt>
                        <dd class="mt-2">@Model.Description</dd>
                    </div>
                </div>
            </div>
        </div>

        <!-- 折扣規則 -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">折扣規則</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-6">最低訂單金額</dt>
                            <dd class="col-sm-6">@(Model.MinOrderAmount > 0 ? $"${Model.MinOrderAmount}" : "無限制")</dd>
                            
                            <dt class="col-sm-6">最高折扣金額</dt>
                            <dd class="col-sm-6">@(Model.MaxDiscountAmount > 0 ? $"${Model.MaxDiscountAmount}" : "無限制")</dd>
                            
                            <dt class="col-sm-6">最低訂單數量</dt>
                            <dd class="col-sm-6">@(Model.MinOrderQuantity > 0 ? $"{Model.MinOrderQuantity} 件" : "無限制")</dd>
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-6">使用限制</dt>
                            <dd class="col-sm-6">@(Model.UsageLimit > 0 ? $"{Model.UsageLimit} 次" : "無限制")</dd>
                            
                            <dt class="col-sm-6">已使用次數</dt>
                            <dd class="col-sm-6">@Model.UsedCount 次</dd>
                            
                            <dt class="col-sm-6">可與其他促銷疊加</dt>
                            <dd class="col-sm-6">@(Model.CanStackWithOthers ? "是" : "否")</dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>

        <!-- 促銷代碼 -->
        @if (Model.RequireCode)
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">促銷代碼</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <span class="me-3">促銷代碼：</span>
                        <code class="bg-light px-3 py-2 rounded">@Model.PromoCode</code>
                        <button class="btn btn-sm btn-outline-secondary ms-2" onclick="copyPromoCode()">
                            <i class="fas fa-copy"></i> 複製
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <!-- 活動期間 -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">活動期間</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-4">開始時間</dt>
                    <dd class="col-8">@Model.StartDate.ToString("yyyy/MM/dd HH:mm")</dd>
                    
                    <dt class="col-4">結束時間</dt>
                    <dd class="col-8">@Model.EndDate.ToString("yyyy/MM/dd HH:mm")</dd>
                    
                    <dt class="col-4">活動天數</dt>
                    <dd class="col-8">@((Model.EndDate - Model.StartDate).Days) 天</dd>
                </dl>
            </div>
        </div>

        <!-- 使用統計 -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">使用統計</h5>
            </div>
            <div class="card-body">
                @if (Model.UsageLimit > 0)
                {
                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span>使用進度</span>
                            <span>@Model.UsagePercentage.ToString("F1")%</span>
                        </div>
                        <div class="progress">
                            <div class="progress-bar @(Model.UsagePercentage > 80 ? "bg-danger" : Model.UsagePercentage > 50 ? "bg-warning" : "bg-success")" 
                                 role="progressbar" 
                                 style="width: @Model.UsagePercentage%" 
                                 aria-valuenow="@Model.UsagePercentage" 
                                 aria-valuemin="0" aria-valuemax="100">
                            </div>
                        </div>
                        <small class="text-muted">@Model.UsedCount / @Model.UsageLimit 次</small>
                    </div>
                }
                else
                {
                    <p>總使用次數：<strong>@Model.UsedCount</strong></p>
                }
                
                <div class="d-grid">
                    <a asp-action="Analytics" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                        <i class="fas fa-chart-line"></i> 詳細分析
                    </a>
                </div>
            </div>
        </div>

        <!-- 進階設定 -->
        @if (Model.Priority > 0 || !string.IsNullOrEmpty(Model.ExclusionGroup))
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">進階設定</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        @if (Model.Priority > 0)
                        {
                            <dt class="col-4">優先順序</dt>
                            <dd class="col-8">@Model.Priority</dd>
                        }
                        
                        @if (!string.IsNullOrEmpty(Model.ExclusionGroup))
                        {
                            <dt class="col-4">排除群組</dt>
                            <dd class="col-8">@Model.ExclusionGroup</dd>
                        }
                        
                        <dt class="col-4">排序順序</dt>
                        <dd class="col-8">@Model.SortOrder</dd>
                    </dl>
                </div>
            </div>
        }

        <!-- 操作按鈕 -->
        <div class="card">
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="fas fa-edit"></i> 編輯活動
                    </a>
                    <a asp-action="Analytics" asp-route-id="@Model.Id" class="btn btn-success">
                        <i class="fas fa-chart-bar"></i> 數據分析
                    </a>
                    <button type="button" class="btn btn-outline-danger" 
                            onclick="deletePromotion(@Model.Id, '@Model.Name')">
                        <i class="fas fa-trash"></i> 刪除活動
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 刪除確認 Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">確認刪除</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>確定要刪除活動「<span id="deletePromotionName"></span>」嗎？</p>
                <p class="text-danger">此操作無法復原！</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <form id="deleteForm" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">確認刪除</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function deletePromotion(id, name) {
            document.getElementById('deletePromotionName').textContent = name;
            document.getElementById('deleteForm').action = '@Url.Action("Delete")/' + id;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }

        function copyPromoCode() {
            const promoCode = '@Model.PromoCode';
            navigator.clipboard.writeText(promoCode).then(function() {
                // 顯示複製成功提示
                const button = event.target.closest('button');
                const originalText = button.innerHTML;
                button.innerHTML = '<i class="fas fa-check"></i> 已複製';
                button.classList.remove('btn-outline-secondary');
                button.classList.add('btn-success');
                
                setTimeout(function() {
                    button.innerHTML = originalText;
                    button.classList.remove('btn-success');
                    button.classList.add('btn-outline-secondary');
                }, 2000);
            });
        }
    </script>
}