<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bear Toy 後台管理</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="admin-wrapper">
        <!-- 左側導航欄 -->
        <nav class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <h3 class="text-center">
                    <i class="bi bi-shop"></i>
                    <span class="sidebar-text">Bear Toy</span>
                </h3>
                <p class="text-center mb-0">
                    <small class="sidebar-text">後台管理系統</small>
                </p>
            </div>
            
            <ul class="sidebar-nav">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" 
                       asp-controller="Home" asp-action="Index">
                        <i class="bi bi-speedometer2"></i>
                        <span class="sidebar-text">儀表板</span>
                    </a>
                </li>
                
                <li class="nav-section">
                    <span class="sidebar-text">商品管理</span>
                </li>
                
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "active" : "")" 
                       asp-controller="Products" asp-action="Index">
                        <i class="bi bi-box-seam"></i>
                        <span class="sidebar-text">商品列表</span>
                    </a>
                </li>
                
                <li class="nav-item">
                    <a class="nav-link" href="#">
                        <i class="bi bi-tags"></i>
                        <span class="sidebar-text">分類管理</span>
                    </a>
                </li>
                
                <li class="nav-section">
                    <span class="sidebar-text">訂單管理</span>
                </li>
                
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" ? "active" : "")" 
                       asp-controller="Orders" asp-action="Index">
                        <i class="bi bi-cart-check"></i>
                        <span class="sidebar-text">訂單列表</span>
                    </a>
                </li>
                
                <li class="nav-item">
                    <a class="nav-link" href="#">
                        <i class="bi bi-truck"></i>
                        <span class="sidebar-text">出貨管理</span>
                    </a>
                </li>
                
                <li class="nav-section">
                    <span class="sidebar-text">會員管理</span>
                </li>
                
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Members" ? "active" : "")" 
                       asp-controller="Members" asp-action="Index">
                        <i class="bi bi-people"></i>
                        <span class="sidebar-text">會員列表</span>
                    </a>
                </li>
                
                <li class="nav-section">
                    <span class="sidebar-text">行銷活動</span>
                </li>
                
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Promotions" asp-action="Index">
                        <i class="bi bi-megaphone"></i>
                        <span class="sidebar-text">促銷活動管理</span>
                    </a>
                </li>
                
                <li class="nav-section">
                    <span class="sidebar-text">系統設定</span>
                </li>
                
                <li class="nav-item">
                    <a class="nav-link" asp-controller="AdminManage" asp-action="Index">
                        <i class="bi bi-people"></i>
                        <span class="sidebar-text">管理員設定</span>
                    </a>
                </li>
                
                <li class="nav-item">
                    <a class="nav-link" href="#">
                        <i class="bi bi-gear"></i>
                        <span class="sidebar-text">系統設定</span>
                    </a>
                </li>
            </ul>
            
            <div class="sidebar-footer">
                <button class="btn btn-sm btn-outline-light w-100" id="toggleSidebar">
                    <i class="bi bi-chevron-left"></i>
                    <span class="sidebar-text">收合選單</span>
                </button>
            </div>
        </nav>

        <!-- 主要內容區 -->
        <div class="main-content">
            <!-- 頂部導航欄 -->
            <nav class="navbar navbar-expand-lg navbar-light bg-white top-navbar">
                <div class="container-fluid">
                    <button class="btn btn-link d-lg-none" id="toggleSidebarMobile">
                        <i class="bi bi-list fs-4"></i>
                    </button>
                    
                    <div class="ms-auto d-flex align-items-center">
                        <div class="dropdown me-3">
                            <button class="btn btn-link position-relative" data-bs-toggle="dropdown">
                                <i class="bi bi-bell fs-5"></i>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                    3
                                </span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><h6 class="dropdown-header">通知</h6></li>
                                <li><a class="dropdown-item" href="#">新訂單 (2)</a></li>
                                <li><a class="dropdown-item" href="#">庫存警告 (1)</a></li>
                            </ul>
                        </div>
                        
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </nav>

            <!-- 頁面內容 -->
            <div class="content-wrapper">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </div>
            
            <!-- 頁尾 -->
            <footer class="admin-footer">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-12 text-center">
                            <small class="text-muted">&copy; 2025 Bear Toy 後台管理系統</small>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>