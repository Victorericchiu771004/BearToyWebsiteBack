@model IEnumerable<BearToyWebsiteBack.Models.Product>

@{
    ViewData["Title"] = "商品管理";
}

<div class="fade-in">
    <!-- 頁面標題和操作區 -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">
                <i class="bi bi-box-seam text-primary me-2"></i>
                商品管理
            </h1>
            <p class="text-muted mb-0">管理您的商品庫存和資訊</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle me-2"></i>
                新增商品
            </a>
        </div>
    </div>

    <!-- 統計卡片 -->
    <div class="row mb-4">
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="stat-card">
                <div class="stat-icon" style="background-color: #fff5f2; color: #ee4d2d;">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div class="stat-value">@Model.Count()</div>
                <div class="stat-label">總商品數</div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="stat-card">
                <div class="stat-icon" style="background-color: #f0f9f0; color: #28a745;">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div class="stat-value">@Model.Count(p => p.StockQuantity > 0)</div>
                <div class="stat-label">有庫存商品</div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="stat-card">
                <div class="stat-icon" style="background-color: #fff3cd; color: #ffc107;">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
                <div class="stat-value">@Model.Count(p => p.StockQuantity <= 5 && p.StockQuantity > 0)</div>
                <div class="stat-label">庫存不足</div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="stat-card">
                <div class="stat-icon" style="background-color: #fff0f0; color: #dc3545;">
                    <i class="bi bi-x-circle"></i>
                </div>
                <div class="stat-value">@Model.Count(p => p.StockQuantity == 0)</div>
                <div class="stat-label">無庫存商品</div>
            </div>
        </div>
    </div>

    <!-- 篩選和搜尋區 -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">搜尋商品</label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" class="form-control" id="searchInput" placeholder="輸入商品名稱或SKU">
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">分類</label>
                    <select class="form-select" id="categoryFilter">
                        <option value="">全部分類</option>
                        @foreach (var category in Model.Select(p => p.Category).Distinct())
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">庫存狀態</label>
                    <select class="form-select" id="stockFilter">
                        <option value="">全部商品</option>
                        <option value="instock">有庫存</option>
                        <option value="lowstock">庫存不足</option>
                        <option value="outofstock">無庫存</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">&nbsp;</label>
                    <div class="d-grid">
                        <button type="button" class="btn btn-outline-secondary" id="clearFilters">
                            <i class="bi bi-arrow-clockwise me-1"></i>
                            重置
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 商品列表 -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-list-ul me-2"></i>
                商品列表
            </h5>
            <div class="d-flex align-items-center">
                <span class="text-muted me-3">共 @Model.Count() 項商品</span>
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn btn-outline-secondary active" id="tableView">
                        <i class="bi bi-table"></i>
                    </button>
                    <button type="button" class="btn btn-outline-secondary" id="cardView">
                        <i class="bi bi-grid-3x3-gap"></i>
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="productsTable">
                    <thead>
                        <tr>
                            <th class="sortable" style="width: 100px;">
                                商品圖片
                            </th>
                            <th class="sortable" style="width: 120px;">
                                商品編號
                                <i class="bi bi-caret-down ms-1"></i>
                            </th>
                            <th class="sortable">
                                商品名稱
                                <i class="bi bi-caret-down ms-1"></i>
                            </th>
                            <th class="sortable" style="width: 150px;">
                                分類
                                <i class="bi bi-caret-down ms-1"></i>
                            </th>
                            <th class="sortable" style="width: 120px;">
                                價格
                                <i class="bi bi-caret-down ms-1"></i>
                            </th>
                            <th class="sortable" style="width: 100px;">
                                庫存
                                <i class="bi bi-caret-down ms-1"></i>
                            </th>
                            <th style="width: 100px;">精選商品</th>
                            <th class="sortable" style="width: 120px;">
                                建立時間
                                <i class="bi bi-caret-down ms-1"></i>
                            </th>
                            <th style="width: 180px;">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr data-category="@item.CategoryId" data-stock="@item.StockQuantity">
                                <td>
                                    @if (item.ProductImages.Any(pi => pi.IsMainImage))
                                    {
                                        var mainImage = item.ProductImages.First(pi => pi.IsMainImage);
                                        <img src="@mainImage.ImageUrl" alt="@mainImage.AltText" class="product-image-preview" />
                                    }
                                    else if (item.ProductImages.Any())
                                    {
                                        var firstImage = item.ProductImages.First();
                                        <img src="@firstImage.ImageUrl" alt="@firstImage.AltText" class="product-image-preview" />
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center justify-content-center product-image-preview bg-light">
                                            <i class="bi bi-image text-muted"></i>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <strong>@item.Sku</strong>
                                </td>
                                <td>
                                    <div>
                                        <strong>@item.Name</strong>
                                        @if (!string.IsNullOrEmpty(item.Description) && item.Description.Length > 50)
                                        {
                                            <small class="d-block text-muted">@(item.Description.Substring(0, 50))...</small>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div>
                                        <span class="badge bg-light text-dark">@item.Category.Name</span>
                                        @if (item.SubCategory != null)
                                        {
                                            <small class="d-block text-muted mt-1">@item.SubCategory.Name</small>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <strong class="text-primary">NT$ @item.Price.ToString("N0")</strong>
                                </td>
                                <td>
                                    @if (item.StockQuantity > 5)
                                    {
                                        <span class="badge bg-success">@item.StockQuantity</span>
                                    }
                                    else if (item.StockQuantity > 0)
                                    {
                                        <span class="badge bg-warning text-dark">@item.StockQuantity</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">售完</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsFeatured)
                                    {
                                        <span class="badge bg-primary">
                                            <i class="bi bi-star-fill me-1"></i>精選
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <small>@item.CreatedAt.ToString("MM/dd")</small>
                                    <br>
                                    <small class="text-muted">@item.CreatedAt.ToString("yyyy")</small>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.Id" 
                                           class="btn btn-outline-info" 
                                           data-bs-toggle="tooltip" 
                                           title="查看詳細">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" 
                                           class="btn btn-outline-warning" 
                                           data-bs-toggle="tooltip" 
                                           title="編輯商品">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" 
                                           class="btn btn-outline-danger delete-confirm" 
                                           data-bs-toggle="tooltip" 
                                           title="刪除商品">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-box-seam display-1 text-muted mb-3"></i>
                    <h4 class="text-muted">尚無商品</h4>
                    <p class="text-muted">點擊上方「新增商品」按鈕開始建立您的第一個商品</p>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-2"></i>
                        新增商品
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // 搜尋功能
            $('#searchInput').on('keyup', function() {
                var value = $(this).val().toLowerCase();
                $('#productsTable tbody tr').filter(function() {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });
            
            // 分類篩選
            $('#categoryFilter').change(function() {
                var categoryId = $(this).val();
                if (categoryId === '') {
                    $('#productsTable tbody tr').show();
                } else {
                    $('#productsTable tbody tr').hide();
                    $('#productsTable tbody tr[data-category="' + categoryId + '"]').show();
                }
            });
            
            // 庫存狀態篩選
            $('#stockFilter').change(function() {
                var stockFilter = $(this).val();
                $('#productsTable tbody tr').show();
                
                if (stockFilter === 'instock') {
                    $('#productsTable tbody tr').filter(function() {
                        return parseInt($(this).data('stock')) <= 0;
                    }).hide();
                } else if (stockFilter === 'lowstock') {
                    $('#productsTable tbody tr').filter(function() {
                        var stock = parseInt($(this).data('stock'));
                        return stock > 5 || stock <= 0;
                    }).hide();
                } else if (stockFilter === 'outofstock') {
                    $('#productsTable tbody tr').filter(function() {
                        return parseInt($(this).data('stock')) > 0;
                    }).hide();
                }
            });
            
            // 重置篩選
            $('#clearFilters').click(function() {
                $('#searchInput').val('');
                $('#categoryFilter').val('');
                $('#stockFilter').val('');
                $('#productsTable tbody tr').show();
            });
            
            // 檢視模式切換
            $('#cardView, #tableView').click(function() {
                $('.btn-group .btn').removeClass('active');
                $(this).addClass('active');
            });
        });
    </script>
}