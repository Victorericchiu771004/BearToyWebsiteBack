@model BearToyWebsiteBack.Models.Product

@{
    ViewData["Title"] = "編輯商品";
}

<div class="fade-in">
    <!-- 頁面標題和導覽 -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">
                <i class="bi bi-pencil text-warning me-2"></i>
                編輯商品
            </h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a asp-action="Index">商品管理</a></li>
                    <li class="breadcrumb-item active" aria-current="page">編輯 @Model.Name</li>
                </ol>
            </nav>
        </div>
        <div>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-info me-2">
                <i class="bi bi-eye me-2"></i>
                查看詳細
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-2"></i>
                返回列表
            </a>
        </div>
    </div>

    <!-- 表單內容 -->
    <form asp-action="Edit" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CreatedAt" />
        
        <div class="row">
            <!-- 基本資訊 -->
            <div class="col-xl-8">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="bi bi-info-circle me-2"></i>
                            基本資訊
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Sku" class="form-label">
                                    商品編號 <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Sku" class="form-control" />
                                <span asp-validation-for="Sku" class="text-danger"></span>
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label">
                                    商品名稱 <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            
                            <div class="col-12">
                                <label asp-for="Description" class="form-label">
                                    商品描述 <span class="text-danger">*</span>
                                </label>
                                <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 定價與庫存 -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="bi bi-currency-dollar me-2"></i>
                            定價與庫存
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Price" class="form-label">
                                    售價 (NT$) <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">NT$</span>
                                    <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
                                </div>
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="StockQuantity" class="form-label">
                                    庫存數量 <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <input asp-for="StockQuantity" class="form-control" type="number" min="0" />
                                    <span class="input-group-text">件</span>
                                </div>
                                <span asp-validation-for="StockQuantity" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 現有圖片管理 -->
                @if (Model.ProductImages.Any())
                {
                    <div class="card mb-4">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                <i class="bi bi-images me-2"></i>
                                現有圖片
                            </h5>
                            <span class="badge bg-secondary">@Model.ProductImages.Count 張圖片</span>
                        </div>
                        <div class="card-body">
                            <div class="row g-3" id="existingImages">
                                @foreach (var image in Model.ProductImages.OrderBy(pi => pi.SortOrder))
                                {
                                    <div class="col-lg-3 col-md-4 col-sm-6" data-image-id="@image.Id">
                                        <div class="card">
                                            <img src="@image.ImageUrl" class="card-img-top" alt="@image.AltText" style="height: 150px; object-fit: cover;">
                                            <div class="card-body p-3">
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    @if (image.IsMainImage)
                                                    {
                                                        <span class="badge bg-primary">主圖</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-light text-dark">圖片 @image.SortOrder</span>
                                                    }
                                                    <button type="button" class="btn btn-sm btn-outline-danger delete-image" data-image-id="@image.Id">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                                <small class="text-muted">@image.AltText</small>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <!-- 新增圖片 -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="bi bi-plus-circle me-2"></i>
                            新增圖片
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">選擇圖片</label>
                            <input type="file" name="productImages" class="form-control" multiple accept="image/*" id="imageInput" />
                            <div class="form-text">
                                <i class="bi bi-info-circle me-1"></i>
                                可以選擇多個圖片檔案。支援 JPG、PNG、GIF 格式。
                            </div>
                        </div>
                        
                        <!-- 圖片預覽區域 -->
                        <div id="imagePreviewContainer" class="border rounded p-3 bg-light" style="display: none;">
                            <h6 class="mb-3">新圖片預覽</h6>
                            <div id="imagePreviewList" class="row g-3"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 側邊欄 -->
            <div class="col-xl-4">
                <!-- 商品狀態 -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="bi bi-clipboard-data me-2"></i>
                            商品狀態
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3 text-center">
                            <div class="col-6">
                                <div class="border rounded p-3">
                                    <h6 class="text-muted mb-1">建立時間</h6>
                                    <small>@Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")</small>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="border rounded p-3">
                                    <h6 class="text-muted mb-1">最後更新</h6>
                                    <small>@Model.UpdatedAt.ToString("yyyy/MM/dd HH:mm")</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 分類設定 -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="bi bi-tags me-2"></i>
                            分類設定
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="CategoryId" class="form-label">
                                主分類 <span class="text-danger">*</span>
                            </label>
                            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId" id="categorySelect">
                                <option value="">請選擇主分類</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="SubCategoryId" class="form-label">子分類</label>
                            <select asp-for="SubCategoryId" class="form-select" id="subCategorySelect">
                                <option value="">請選擇子分類</option>
                            </select>
                            <span asp-validation-for="SubCategoryId" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- 商品設定 -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="bi bi-gear me-2"></i>
                            商品設定
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="IsFeatured" id="featuredSwitch" />
                            <label class="form-check-label" for="featuredSwitch">
                                <strong>精選商品</strong>
                                <small class="d-block text-muted">精選商品會在首頁顯示</small>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- 操作按鈕 -->
                <div class="card">
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-warning btn-lg">
                                <i class="bi bi-check-circle me-2"></i>
                                儲存變更
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-2"></i>
                                取消
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function() {
            // 載入子分類
            var categoryId = $('#categorySelect').val();
            var selectedSubCategoryId = '@Model.SubCategoryId';
            
            if (categoryId) {
                loadSubCategories(categoryId, selectedSubCategoryId);
            }
            
            // 分類變更事件
            $('#categorySelect').change(function() {
                var categoryId = $(this).val();
                $('#subCategorySelect').empty();
                $('#subCategorySelect').append('<option value="">請選擇子分類</option>');
                
                if (categoryId) {
                    loadSubCategories(categoryId, null);
                }
            });
            
            // 載入子分類函數
            function loadSubCategories(categoryId, selectedId) {
                $.ajax({
                    url: '@Url.Action("GetSubCategories", "Products")',
                    type: 'GET',
                    data: { categoryId: categoryId },
                    success: function(data) {
                        $.each(data, function(index, item) {
                            var option = '<option value="' + item.value + '"';
                            if (selectedId && item.value == selectedId) {
                                option += ' selected';
                            }
                            option += '>' + item.text + '</option>';
                            $('#subCategorySelect').append(option);
                        });
                    }
                });
            }
            
            // 刪除圖片功能
            $('.delete-image').click(function() {
                var button = $(this);
                var imageId = button.data('image-id');
                var imageDiv = button.closest('[data-image-id]');
                
                // 使用 SweetAlert 或 Bootstrap Modal 可以提供更好的用戶體驗
                if (confirm('確定要刪除這張圖片嗎？此操作無法復原。')) {
                    button.prop('disabled', true).html('<i class="bi bi-hourglass-split"></i>');
                    
                    $.ajax({
                        url: '@Url.Action("DeleteImage", "Products")',
                        type: 'POST',
                        data: { 
                            imageId: imageId,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(result) {
                            if (result.success) {
                                imageDiv.fadeOut(300, function() {
                                    $(this).remove();
                                    
                                    // 更新圖片數量
                                    var remainingImages = $('#existingImages [data-image-id]').length;
                                    $('.badge:contains("張圖片")').text(remainingImages + ' 張圖片');
                                    
                                    // 顯示成功訊息
                                    showAlert('success', '圖片已成功刪除');
                                });
                            } else {
                                button.prop('disabled', false).html('<i class="bi bi-trash"></i>');
                                showAlert('danger', '刪除圖片失敗，請稍後再試');
                            }
                        },
                        error: function() {
                            button.prop('disabled', false).html('<i class="bi bi-trash"></i>');
                            showAlert('danger', '刪除圖片時發生錯誤');
                        }
                    });
                }
            });
            
            // 圖片預覽功能
            $('#imageInput').change(function() {
                var files = this.files;
                var previewContainer = $('#imagePreviewContainer');
                var previewList = $('#imagePreviewList');
                
                previewList.empty();
                
                if (files.length > 0) {
                    previewContainer.show();
                    
                    for (var i = 0; i < files.length; i++) {
                        if (files[i].type.match('image.*')) {
                            var reader = new FileReader();
                            reader.onload = (function(file, index) {
                                return function(e) {
                                    var previewHtml = `
                                        <div class="col-6 col-md-4">
                                            <div class="card">
                                                <img src="${e.target.result}" class="card-img-top" style="height: 120px; object-fit: cover;">
                                                <div class="card-body p-2">
                                                    <small class="text-muted d-block">${file.name}</small>
                                                    <span class="badge bg-success mt-1">新圖片</span>
                                                </div>
                                            </div>
                                        </div>
                                    `;
                                    previewList.append(previewHtml);
                                };
                            })(files[i], i);
                            reader.readAsDataURL(files[i]);
                        }
                    }
                } else {
                    previewContainer.hide();
                }
            });
            
            // 顯示警告訊息函數
            function showAlert(type, message) {
                var alertHtml = `
                    <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                        <i class="bi bi-${type === 'success' ? 'check-circle' : 'exclamation-triangle'} me-2"></i>
                        ${message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                `;
                
                $('.fade-in').prepend(alertHtml);
                
                // 自動關閉
                setTimeout(function() {
                    $('.alert').alert('close');
                }, 3000);
            }
        });
    </script>
}